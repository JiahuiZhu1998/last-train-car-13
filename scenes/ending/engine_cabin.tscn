bbcode_enabled = true
text = "[center][color=#9fb8ff]The engine is silent.[/color]

There is no driver.
The windshield is cracked.

[color=#cccccc]A newspaper lies beside the controls.[/color]

[color=#ffb088]Night Express 13 — Fatal Derailment.[/color]
No survivors.

[color=#9fb8ff]You remember.[/color]
You were on this train.
You never survived the crash.

[color=#ffffff]LAST TRAIN: CAR 13[/color]
[color=#ffffff]END[/color][/center]"
autowrap_mode = 3
