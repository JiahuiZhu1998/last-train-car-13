offset_bottom = 140.0
bbcode_enabled = true
text = "[center][color=#aaaaff]You reach the driver's cabin.[/color]

The seat is empty.

On the dashboard, a photograph.

A group of passengers. A train. A date: years ago.

[color=#ccaaff]You are in the photograph.[/color]

You have been on this train since the accident.
You simply forgot.

The train slows.
For the first time in years, it slows.

[color=#ffffff]You finally remember where you were going.[/color][/center]"
autowrap_mode = 3
theme_override_font_sizes/normal_font_size = 10

