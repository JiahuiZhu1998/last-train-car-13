; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but you can edit it manually for advanced use cases.

config_version=5

[application]

config/name="Last Train: Car 13"
config/description="A supernatural mystery RPG set aboard a night train."
config/version="0.1.0"
run/main_scene="res://scenes/train/passenger_car.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.svg"

[autoload]

GameState="*res://scripts/game/game_state.gd"
SceneTransition="*res://scripts/game/scene_transition.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/initial_scale=3.0
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

